# machine.env — TEMPLATE for a NEW machine (SET C, D, ...).
# 1. bash vm/select-machine.sh new <name>     (copies this dir to machines/<name>)
# 2. Fill every value below — derivation commands in machines/TEMPLATE/NOTES.md
# 3. bash vm/select-machine.sh <name>         (activates the set)
# Any value left empty is autodetected at runtime (default-route NIC / its IP / active NM connection).

MACHINE_SET="TEMPLATE"
M_OS=""                                # e.g. "Ubuntu 24.04" / "openSUSE Leap 16" / "Debian 12"
M_HOST_PREP=""                         # vm/setup_host_Ubuntu.sh (apt) or vm/setup_host_OpenSuseOS.sh (zypper);
                                       # anything else: adapt one of those first

M_LAN_IF_DEFAULT=""                    # ip route show default   → "dev <X>"
M_NM_CONN=""                           # nmcli -t -f NAME,DEVICE,STATE con show | grep ':<X>:activated'
M_LAN_IP_DEFAULT=""                    # ip -4 addr show <X> | grep -oP 'inet \K[\d.]+'

M_URL_HOST=""                          # what to type in the browser: the IP (always works),
                                       # or <hostname>.local ONLY if mDNS resolves correctly here (test!)
M_MDNS_OK=""                           # 1 = .local works (no docker bridges registering with avahi); 0 = use IP

M_GUEST_MTU=""                         # empty = clean 1500 path. If wired/WiFi path is smaller:
                                       # ping -M do -s 1472 1.1.1.1 → bisect the largest passing size + 28
                                       # (ailab WiFi = 1280). Also see MSS clamp note in machines/ailab/NOTES.md
