# machine.env — SET A: "P71" (original host, openSUSE Leap 16, wired).
# Selected with: bash vm/select-machine.sh P71
# Any value left empty is autodetected at runtime (default-route NIC / its IP / active NM connection).
# env overrides still win: RRR_LAN_IF, RRR_LAN_IP, RRR_URL_HOST, RRR_NM_CONN

MACHINE_SET="P71"
M_OS="openSUSE Leap 16"                # libvirt MODULAR daemons (virtqemud etc.)
M_HOST_PREP="vm/setup_host_OpenSuseOS.sh"  # run with sudo on a fresh P71-like host

M_LAN_IF_DEFAULT="enp0s31f6"           # default-route NIC as built on P71
M_NM_CONN="Wired connection 1"         # NetworkManager connection name (fix-host-dns.sh)
M_LAN_IP_DEFAULT="192.168.1.81"        # as-built LAN IP (DHCP — autodetect handles drift)

M_URL_HOST="P71.local"                 # what to type in the browser on THIS host
M_MDNS_OK="1"                          # 1 = <hostname>.local resolves correctly here

M_GUEST_MTU=""                         # empty = clean 1500 path (wired); no guest MTU pin needed
                                       # (the MSS clamp in the port-forward hook is harmless belt+braces)
