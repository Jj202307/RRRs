# SET B network-config (ailab) — WiFi host with path MTU 1280, host DNS chain first.
# 192.168.122.1 (host dnsmasq) is the PRIMARY on purpose: it makes guest DNS follow the
# host resolver, which Surfshark rewrites to its own resolvers while the VPN is up
# (verified live 2026-09-29). 1.1.1.1 is the fallback (also tunnel-carried, no leak).
# Host DNS must stay pinned to 1.1.1.1 when the VPN is off: sudo bash vm/fix-host-dns.sh
version: 2
ethernets:
  main:
    match:
      name: "en*s*"
    mtu: 1280
    addresses:
      - 192.168.122.50/24
    routes:
      - to: default
        via: 192.168.122.1
    nameservers:
      addresses:
        - 192.168.122.1
        - 1.1.1.1
