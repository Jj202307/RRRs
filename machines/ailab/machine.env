# machine.env — SET B: "ailab" (current host, Ubuntu 24.04, WiFi).
# Selected with: bash vm/select-machine.sh ailab
# Any value left empty is autodetected at runtime (default-route NIC / its IP / active NM connection).
# env overrides still win: RRR_LAN_IF, RRR_LAN_IP, RRR_URL_HOST, RRR_NM_CONN

MACHINE_SET="ailab"
M_OS="Ubuntu 24.04"                    # libvirt MONOLITHIC (libvirtd + persistent-args override)
M_HOST_PREP="vm/setup_host_Ubuntu.sh"  # run with sudo on a fresh Ubuntu/Debian host

M_LAN_IF_DEFAULT="wlp71s0"             # default-route NIC (WiFi)
M_NM_CONN="Eagle6"                     # NetworkManager connection name (fix-host-dns.sh)
M_LAN_IP_DEFAULT="192.168.1.66"        # as-built LAN IP (DHCP — autodetect handles drift)

# !!! mDNS is POISONED on this host: Docker/Calico bridges (docker0, vxlan.calico) register with
# !!! avahi, so "ailab.local" resolves to 172.17.0.1 / link-local junk. ALWAYS use the raw IP here.
M_URL_HOST="192.168.1.66"
M_MDNS_OK="0"                          # 0 = never advertise hostname.local URLs on this host

M_GUEST_MTU="1280"                     # WiFi uplink path MTU (verified by DF-ping bisect);
                                       # paired with MSS clamp 1240 in the port-forward hook
